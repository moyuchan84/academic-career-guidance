---
layout: null
permalink: /search.json
---
{%- assign ps = site.pages | where_exp: "p", "p.title" -%}
[{%- for p in ps -%}
{"t":{{ p.title | jsonify }},"u":{{ p.url | relative_url | jsonify }},"s":{{ p.parent | default: "" | jsonify }},"c":{{ p.content | markdownify | strip_html | normalize_whitespace | truncate: 5000 | jsonify }}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}]
